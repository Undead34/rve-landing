, and validates the final state.\nIf valid, the repository is updated.\nRuntime execution is currently unavailable; writes affect the repository only.\nNon-fatal validation warnings are logged but will not prevent the patch.","operationId":"patch_rule","parameters":[{"name":"id","in":"path","description":"Unique identifier of the rule (UUID)","required":true,"schema":{"type":"string"},"example":"019c7d7b-dc31-7fa9-8b1b-10e4fe820cb8"}],"requestBody":{"description":"Partial rule configuration payload containing only the fields to be updated","content":{"application/json":{"schema":{}}},"required":true},"responses":{"200":{"description":"Rule successfully patched","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RuleDoc"}}}},"400":{"description":"Invalid rule ID format or malformed patch payload provided","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Rule not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Version conflict when If-Match does not match current rule","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"422":{"description":"Validation failed for the rule's final state after applying the patch","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal server error during repository update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/ui/builder-config":{"get":{"tags":["metadata"],"operationId":"builder_config","responses":{"200":{"description":"UI builder configuration — operator palette, root vars, enums, and rule field definitions for dynamic form generation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BuilderConfigResponseDoc"}}}}}}},"/health":{"get":{"tags":["health"],"summary":"Health check","description":"Verifies that the service is running and responsive.\nReturns a simple health status along with a special custom header.","operationId":"handler","responses":{"200":{"description":"Service is healthy and ready to accept requests","headers":{"X-Miku":{"schema":{"type":"string"},"description":"Miku says: thank you (39)"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponse"}}}}}}}},"components":{"schemas":{"BuilderConfigResponseDoc":{"type":"object","required":["operator_groups","root_vars","enums","rule_fields","rule_schema_version"],"properties":{"enums":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}},"propertyNames":{"type":"string"}},"operator_groups":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}},"propertyNames":{"type":"string"}},"root_vars":{"type":"array","items":{"type":"string"}},"rule_fields":{"type":"array","items":{"$ref":"#/components/schemas/FieldDefDoc"}},"rule_schema_version":{"type":"string"}}},"DecisionHitDoc":{"type":"object","required":["rule_id","action","severity","score_delta","tags"],"properties":{"action":{"type":"string"},"explanation":{"type":["string","null"]},"rule_id":{"type":"string"},"score_delta":{"type":"number","format":"float"},"severity":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}}}},"DecisionRequestDoc":{"type":"object","required":["header","context","features","signals","payload"],"properties":{"context":{"description":"Snapshot context (`geo`, `net`, `env`)."},"features":{"description":"Historical anti-fraud features.\nCurrent contract expects a complete `features.fin` object, not a partial patch."},"header":{"description":"Header context.\n`event_id` is optional, but when present it must be a valid UUID string."},"payload":{"description":"Transaction payload.\n`payload.parties.originator` and `payload.parties.beneficiary` are required.\nCanonical contract expects `payload.type = \\\"value_transfer\\\"` and\n`payloa